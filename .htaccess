<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# The service worker and manifest must never be served from cache. Hostinger
# was sending sw.js with max-age=604800, so an installed phone would keep the
# previous worker - and therefore the previous cached assets - for days, making
# deployed fixes look like they had no effect.
<IfModule mod_headers.c>
    # Extracted CSS and JS are cache-busted with ?v=<filemtime>, so the URL
    # changes whenever the file does — safe to cache hard. Without this the
    # extracted files would be re-downloaded on every page load, defeating the
    # point of extracting them.
    <FilesMatch "\.css$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # MUST stay AFTER the .js rule above so it wins for these two files: the
    # service worker and manifest must never be cached, or an installed phone
    # keeps the previous worker (and its cached assets) for days, making
    # deployed fixes look like they had no effect.
    <FilesMatch "^(sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
